    "expo-router": "57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
