{
  "name": "conjugator",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "web:dev": "npm run dev --workspace musarrif-web --",
    "web:build": "npm run build --workspace musarrif-web",
    "web:build:hash": "npm run build:hash --workspace musarrif-web",
    "web:preview": "npm run preview --workspace musarrif-web --",
    "web:prerender": "npm run prerender --workspace musarrif-web --",
    "web:test": "npm run test --workspace musarrif-web --",
    "web:typecheck": "npm run typecheck --workspace musarrif-web --",
    "desktop:dev": "npm run tauri:dev --workspace musarrif-web --",
    "desktop:build": "npm run tauri:icons --workspace musarrif-web && npm run tauri:build --workspace musarrif-web",
    "desktop:icons": "npm run tauri:icons --workspace musarrif-web --",
    "mobile:start": "npm run start --workspace musarrif-mobile",
    "mobile:ios": "npm run ios --workspace musarrif-mobile",
    "mobile:typecheck": "npm run typecheck --workspace musarrif-mobile",
    "mobile:test": "npm run test --workspace musarrif-mobile",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:mutation": "stryker run",
    "test:mutation:paradigms": "stryker run stryker.paradigms.config.mjs",
    "check:all": "npm run check:lint && npm run check:roots && npm run check:boundaries && npm test -- --no-watch && npm run check:types && npm run web:typecheck && npm run mobile:typecheck && npm run mobile:test && npm exec --workspace musarrif-web -- vite build",
    "check:roots": "ajv validate -s src/data/roots.schema.json -d src/data/roots.json --strict=true --all-errors --errors=text",
    "check:lint": "biome check .",
    "check:boundaries": "depcruise src scripts apps/web/src apps/web/scripts",
    "check:types": "tsc -b tsconfig.src.json",
    "format": "biome check --write --unsafe . && biome format --write .",
    "add:verb": "tsx scripts/verb.mts",
    "add:verb:wizard": "tsx scripts/verb-wizard.mts",
    "count:verbs": "jq 'length' src/data/roots.json",
    "debug:elixirfm": "tsx scripts/debug-elixirfm.mts",
    "debug:explain": "tsx scripts/debug-explain.mts",
    "debug:srs": "tsx scripts/debug-srs.mts",
    "report:srs": "tsx scripts/report-srs.mts",
    "add:tests": "tsx scripts/test-verb.mts",
    "glosses": "tsx scripts/glosses.mts",
    "frequency": "tsx scripts/frequency.mts"
  },
  "dependencies": {
    "@pacote/buckwalter": "^0.1.1",
    "@pacote/memoize": "^3.0.2",
    "@pacote/shuffle": "^3.0.1",
    "expo": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@inquirer/prompts": "^8.7.5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "^1.16.22",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "ajv-cli": "^5.0.0",
    "dependency-cruiser": "^18.7.2",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.1.5",
    "react-native-worklets": "0.13.0",
    "react-native-reanimated": "4.7.1"
  },
  "version": "1.0.0"
}
