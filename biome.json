{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.tsx", "**/*.test.ts", "**/*.test.mts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/**/*.test.ts", "!src/**/*.test.tsx", "!src/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Shared code runs on web, mobile and in scripts. Pass browser state in from the app instead.",
                  "document": "Shared code runs on web, mobile and in scripts. Pass browser state in from the app instead.",
                  "localStorage": "Shared code runs on web, mobile and in scripts. Pass storage in from the app instead.",
                  "navigator": "Shared code runs on web, mobile and in scripts. Pass browser state in from the app instead."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
